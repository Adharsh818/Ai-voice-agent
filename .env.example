# ===================================
# Pearl Dental Clinic Voice Agent
# Environment Configuration
# ===================================

# --- Required: Gemini LLM ---

# Google Gemini (for LLM / NLU extraction)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# --- Required: Google Cloud Speech & TTS ---

# Path to your Google Cloud service account JSON key file.
# Steps:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project and enable:
#        - Cloud Speech-to-Text API
#        - Cloud Text-to-Speech API
#   3. Create a Service Account → download key as JSON
#   4. Set this path to that JSON file (or use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Your GCP Project ID (required if not using service account JSON)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# --- Optional: Google TTS Voice Settings ---

# BCP-47 language code for STT and TTS
# See: https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_LANGUAGE_CODE=en-IN

# Google TTS voice name (WaveNet voices are highest quality)
# Popular options:
#   en-IN-Wavenet-D  (Indian English, female)
#   en-IN-Wavenet-A  (Indian English, female)
#   en-US-Neural2-F  (US English, female)
GOOGLE_TTS_VOICE_NAME=en-IN-Wavenet-D

# Speaking rate: 1.0 = normal, 0.85 = slightly slower, 1.15 = slightly faster
GOOGLE_TTS_SPEAKING_RATE=1.0

# Voice pitch in semitones: 0.0 = default, positive = higher, negative = lower
GOOGLE_TTS_PITCH=0.0

# --- Optional: Asterisk AGI Settings ---

# Asterisk audio sample rate (8000 Hz = G.711 standard, 16000 Hz = wideband)
ASTERISK_SAMPLE_RATE=8000

# --- Optional: Server Settings ---

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# IANA timezone used for availability checks and Calendar events
CLINIC_TIMEZONE=Asia/Kolkata

# --- Optional: Google Calendar & Sheets APIs ---

# Set to False to use real Google Calendar & Sheets APIs
USE_MOCK_APIS=True

GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_SPREADSHEET_ID=

# --- Optional: Legacy CLI mode ---

# LLM provider for legacy main.py (gemini or ollama)
LLM_PROVIDER=gemini
OLLAMA_MODEL=llama3
