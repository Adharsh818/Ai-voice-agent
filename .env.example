# =====================================================================
# Emma — Pearl Dental voice agent. Copy to .env and fill in the keys.
# .env is git-ignored; never commit real keys.
# Only the three API keys are required; everything else has a working default.
# =====================================================================

# --- Required API keys ---------------------------------------------------
# Gemini (language understanding): https://aistudio.google.com/apikey
# One key only. Use a paid / no-training tier before any real patient data.
GEMINI_API_KEY=
# Deepgram (speech-to-text): https://console.deepgram.com/
DEEPGRAM_API_KEY=
# ElevenLabs (text-to-speech): https://elevenlabs.io/  (free tier: 10,000 characters/month)
ELEVENLABS_API_KEY=

# --- Server ----------------------------------------------------------------
# Loopback only by default. Do not expose to a network without TLS and a login.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Extra browser origins allowed to open a call, comma-separated (the page's own
# origin is always allowed), e.g. https://emma.example.org
ALLOWED_ORIGINS=

# --- Clinic ----------------------------------------------------------------
CLINIC_TIMEZONE=Asia/Kolkata

# --- Realism (docs/NORTH_STAR.md) ------------------------------------------
# Browser demo sounds like a phone call (band-limited, lightly compressed).
PHONE_LINE_EFFECT=true
# Clinic sound follows the call: heard only while Emma speaks or types.
# Run `python tools/fetch_ambience.py` once to download the approved recordings.
AMBIENCE_ENABLED=true
AMBIENCE_MURMUR_DB=-38
AMBIENCE_EVENT_DB=-34
# Typing when the caller gives details and while Emma checks the diary.
TYPING_SFX=true
TYPING_BEAT_MIN_MS=650
TYPING_BEAT_MAX_MS=1000
# Soft breath before sentences of at least this many words (0 = off).
BREATH_BEFORE_WORDS=20

# --- Gemini tuning -----------------------------------------------------------
# A Flash-Lite model you have verified; checked at startup and re-checked while failing.
GEMINI_MODEL=gemini-3.5-flash-lite
# Used for the one retry after an overload; empty = retry on GEMINI_MODEL.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Hard per-turn budget in seconds, including the retry.
GEMINI_TIMEOUT=2.5
# MINIMAL / LOW / ..., an integer token budget, or empty to send nothing.
GEMINI_THINKING=MINIMAL
# Seconds between re-checks while the model check is failing.
GEMINI_REVERIFY_S=60
# Resolve short, unambiguous turns without the LLM.
TIER0_ENABLED=true

# --- Speech-to-text (Deepgram) -----------------------------------------------
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-IN
# Silence (ms) before Deepgram marks speech_final.
DEEPGRAM_ENDPOINTING_MS=200
# Backstop when speech_final never arrives (Deepgram's minimum is 1000).
DEEPGRAM_UTTERANCE_END_MS=1000
# Optional: comma-separated words to boost (defaults cover branches and services).
# DEEPGRAM_KEYTERMS=

# --- Text-to-speech (ElevenLabs) ---------------------------------------------
# Voice ID from https://elevenlabs.io/voice-library (default: "Rachel")
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
# Raw 16 kHz PCM: no decoder in the browser, exact flushes on barge-in.
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
# ws = one multi-context WebSocket per call; http = streaming POST per reply.
TTS_TRANSPORT=ws

# --- Turn-taking ---------------------------------------------------------------
# Play a short "Okay." if an LLM turn is still thinking after this many ms.
FILLER_AFTER_MS=450
BARGE_IN_ENABLED=true
# Caller words needed to interrupt Emma (urgent words like "stop" need one).
BARGE_IN_MIN_WORDS=2

# --- Development ---------------------------------------------------------------
# Save each caller's audio + what STT heard to captures/ (contains voices; off by default).
DEV_CAPTURE_AUDIO=false
# Override runtime folders if needed.
# EMMA_CACHE_DIR=cache
# EMMA_LOG_DIR=logs
# EMMA_CAPTURE_DIR=captures

# --- Appointments ----------------------------------------------------------------
# SQLite database (created and migrated on start). Google Calendar becomes a
# one-way mirror of it on Day 4; nothing reads Calendar during a call.
# EMMA_DB_PATH=data/emma.db
# Fill an empty database with the DEMO clinic (4 branches, 8 fictional doctors).
DEMO_SEED_ON_EMPTY=true
# Branch the current single-branch dialogue books at (until the Day 2 workflows).
DEFAULT_BRANCH=Nagarbhavi
# Scheduling policy: bookable days ahead, minimum notice in minutes (normal and
# emergency), how long offered slots are held (seconds), future bookings per number.
BOOKING_HORIZON_DAYS=60
BOOKING_LEAD_MIN=120
EMERGENCY_LEAD_MIN=30
HOLD_TTL_S=300
MAX_FUTURE_APPOINTMENTS_PER_PHONE=3
