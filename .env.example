# =====================================================================
# Emma — Pearl Dental voice agent. Copy to .env and fill in the keys.
# .env is git-ignored; never commit real keys.
# Only the three API keys are required; everything else has a working default.
# =====================================================================

# --- Required API keys ---------------------------------------------------
# Gemini (language understanding): https://aistudio.google.com/apikey
# One key only. Use a paid / no-training tier before any real patient data.
GEMINI_API_KEY=
# Deepgram (speech-to-text): https://console.deepgram.com/
DEEPGRAM_API_KEY=
# ElevenLabs (text-to-speech): https://elevenlabs.io/  (free tier: 10,000 characters/month)
ELEVENLABS_API_KEY=

# --- Server ----------------------------------------------------------------
# Loopback only by default. Do not expose to a network without TLS and a login.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Extra browser origins allowed to open a call, comma-separated (the page's own
# origin is always allowed), e.g. https://emma.example.org
ALLOWED_ORIGINS=

# --- Clinic ----------------------------------------------------------------
CLINIC_TIMEZONE=Asia/Kolkata

# --- Realism (docs/NORTH_STAR.md) ------------------------------------------
# Browser demo sounds like a phone call (band-limited, lightly compressed).
PHONE_LINE_EFFECT=true
# Clinic sounds follow the call (no background bed): an occasional door, chair
# or footsteps while Emma speaks or types. Run `python tools/fetch_ambience.py`
# once to download the approved recordings.
AMBIENCE_ENABLED=true
AMBIENCE_EVENT_DB=-34
# Typing when the caller gives details and while Emma checks the diary.
TYPING_SFX=true
# The note-taking beat overlaps the engine's work (the reply waits max(engine, beat)).
TYPING_BEAT_MIN_MS=150
TYPING_BEAT_MAX_MS=300
# Soft breath before sentences of at least this many words (0 = off).
BREATH_BEFORE_WORDS=20

# --- Gemini tuning -----------------------------------------------------------
# A Flash-Lite model you have verified; checked at startup and re-checked while failing.
GEMINI_MODEL=gemini-3.5-flash-lite
# Used for the one retry after an overload; empty = retry on GEMINI_MODEL.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Hard per-turn budget in seconds, including the retry.
GEMINI_TIMEOUT=2.5
# MINIMAL / LOW / ..., an integer token budget, or empty to send nothing.
GEMINI_THINKING=MINIMAL
# Seconds between re-checks while the model check is failing.
GEMINI_REVERIFY_S=60
# Resolve short, unambiguous turns without the LLM.
TIER0_ENABLED=true
# true = the R2 conversation engine (dialogue/, docs/R2_DESIGN.md); false = the 12-step machine.
# R2_ENGINE=false
# R2: seconds the model has to deliver its understanding before the turn falls back (design: 1.6;
# about 2.2 works better with Flash-Lite on a cold or long brief).
# NLU_HEAD_DEADLINE_S=1.6
# Seconds between keep-warm model requests while no call is on (0 = off; one also runs at startup).
# NLU_KEEP_WARM_S=240
# The model's head start when Emma's own rules already understood the turn clearly (a name, number, yes, request).
# NLU_FAST_DEADLINE_S=0.8

# --- Speech-to-text (Deepgram) -----------------------------------------------
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-IN
# Silence (ms) before Deepgram marks speech_final. turn_detector.py then waits
# on the words themselves ("yes" commits at once, "and..." waits), so 200-400
# all work; 300 is the recommended balance.
DEEPGRAM_ENDPOINTING_MS=300
# Backstop when speech_final never arrives (Deepgram's minimum is 1000).
DEEPGRAM_UTTERANCE_END_MS=1000
# Optional: comma-separated words to boost (defaults cover branches and services).
# DEEPGRAM_KEYTERMS=

# --- Text-to-speech (ElevenLabs) ---------------------------------------------
# Voice ID from https://elevenlabs.io/voice-library (default: "Rachel")
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5
# Raw 16 kHz PCM: no decoder in the browser, exact flushes on barge-in.
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
# ws = one multi-context WebSocket per call; http = streaming POST per reply.
TTS_TRANSPORT=ws

# --- Turn-taking ---------------------------------------------------------------
# Play a short "Okay." if an LLM turn is still thinking after this many ms.
FILLER_AFTER_MS=450
BARGE_IN_ENABLED=true
# Caller words needed to interrupt Emma (urgent words like "stop" need one).
BARGE_IN_MIN_WORDS=2

# --- Development ---------------------------------------------------------------
# Save each caller's audio + what STT heard to captures/ (contains voices; off by default).
DEV_CAPTURE_AUDIO=false
# Print the caller's words in the console log. Set false before real patient calls.
# LOG_CALLER_TEXT=true
# Override runtime folders if needed.
# EMMA_CACHE_DIR=cache
# EMMA_LOG_DIR=logs
# EMMA_CAPTURE_DIR=captures

# --- Appointments ----------------------------------------------------------------
# SQLite database (created and migrated on start). Google Calendar is a
# one-way mirror of it (below); nothing reads Calendar during a call.
# EMMA_DB_PATH=data/emma.db
# Fill an empty database with the DEMO clinic (4 branches, 8 fictional doctors).
DEMO_SEED_ON_EMPTY=true
# Branch the current single-branch dialogue books at (until the Day 2 workflows).
DEFAULT_BRANCH=Nagarbhavi
# Scheduling policy: bookable days ahead, minimum notice in minutes (normal and
# emergency), how long offered slots are held (seconds), future bookings per number.
BOOKING_HORIZON_DAYS=60
BOOKING_LEAD_MIN=120
EMERGENCY_LEAD_MIN=30
HOLD_TTL_S=300
MAX_FUTURE_APPOINTMENTS_PER_PHONE=3

# --- Recovery calls (Dashboard > Recovery; the patient's phone is /patient) ------
# Clinic-local hours Emma may call patients about a doctor's absence.
RECOVERY_CALL_WINDOW=09:00-20:00
# Seconds the patient's phone rings before the attempt counts as no answer.
RECOVERY_RING_TIMEOUT_S=30
# Unanswered calls are tried again, this many attempts in all, this many minutes apart.
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_RETRY_GAP_MIN=120

# --- Staff dashboard (/dashboard) -------------------------------------------------
# Locked until this is set. Run `python tools/hash_password.py`: it asks for a
# password and prints both lines below. Never put the password itself here.
DASHBOARD_PASSWORD_HASH=
# Signs the login cookie; empty = staff are logged out whenever the server restarts.
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_HOURS=12
# true once the dashboard is served over HTTPS.
DASHBOARD_COOKIE_SECURE=false
# Failed logins per client within the window before a lockout of the same length (seconds).
DASHBOARD_LOGIN_MAX_FAILURES=5
DASHBOARD_LOGIN_WINDOW_S=300

# --- Transcripts ------------------------------------------------------------------
# No audio is recorded. Transcript text older than this many days is blanked
# (checked at startup and every TRANSCRIPT_PURGE_HOURS).
TRANSCRIPT_RETENTION_DAYS=30
TRANSCRIPT_PURGE_HOURS=6

# --- Google Calendar mirror ---------------------------------------------------------
# A service account owns one DEMO calendar per branch; see README "Google Calendar".
# Without the key file the sync stays off and /health says why.
CALENDAR_SYNC_ENABLED=true
# GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# The demo Gmail the branch calendars are shared with, read-only.
CALENDAR_SHARE_WITH=
# Seconds between outbox checks when nothing wakes the worker.
CALENDAR_POLL_S=5

# Backup voice when ElevenLabs fails or runs out (models/piper/<name>.onnx; fetch with tools/fetch_piper_voice.py). Empty = off.
PIPER_VOICE=en_GB-cori-medium

# --- Phone calls through Asterisk (docs/TELEPHONY.md; off by default) ---
# tools/telephony_setup.py adds these to .env with generated secrets.
TELEPHONY_ENABLED=false
AUDIOSOCKET_PORT=9092
# Shared with the dialplan's /telephony/register and /telephony/next calls (loopback only)
TELEPHONY_SECRET=
# Where Emma's live transfers go; empty keeps "the clinic will call you back"
TELEPHONY_FRONT_DESK=PJSIP/1002
# Keypad digits become one caller turn after "#" or this many seconds of quiet
DTMF_TIMEOUT_S=3
# Recovery calls ring a SIP phone through the Asterisk Manager Interface (empty AMI_USER: browser only)
AMI_USER=
AMI_SECRET=
TELEPHONY_PATIENT_PHONE=PJSIP/1001
TELEPHONY_CLINIC_CID="Pearl Dental" <08041234567>
