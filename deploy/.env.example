# Copy to deploy/.env on the VM and fill in. Never commit deploy/.env.

# --- Public address (Caddy gets a Let's Encrypt certificate for it) ---
# No domain? Use <VM external IP>.sslip.io, e.g. 34.93.10.20.sslip.io
EMMA_DOMAIN=34.93.10.20.sslip.io

# --- Login for the talk page ---
# Hash: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the bcrypt hash contains '$'.
EMMA_BASIC_AUTH_USER=emma
EMMA_BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# --- Real-time pipeline keys ---
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- Clinic ---
CLINIC_TIMEZONE=Asia/Kolkata
DISCLOSE_AI=true

# --- Google Calendar / Sheets ---
# Keep True until deploy/secrets/credentials.json is in place and verified.
# Use a service-account key: the OAuth browser flow cannot run on a headless VM.
USE_MOCK_APIS=True
GOOGLE_CALENDAR_ID=primary
GOOGLE_SPREADSHEET_ID=
