{
  "_note": "Read each line naturally, pause about 2 seconds between lines. 'expect' holds the values a correct transcript must yield (checked with dateparse/phones on Day 3). Dates are relative, so only the kind of date is checked.",
  "lines": [
    {"id": 1,  "say": "Hi, I'd like to book an appointment please.", "expect": {"intent": "book"}},
    {"id": 2,  "say": "My name is Adharsh Kumar.", "expect": {"name": "Adharsh Kumar"}},
    {"id": 3,  "say": "It's nine eight seven six five, four three two one zero.", "expect": {"phone": "+919876543210"}},
    {"id": 4,  "say": "Double nine, eight seven six, five four three, two one.", "expect": {"phone": "+919987654321"}},
    {"id": 5,  "say": "Yes, that's correct.", "expect": {"confirmation": "yes"}},
    {"id": 6,  "say": "No, that's wrong.", "expect": {"confirmation": "no"}},
    {"id": 7,  "say": "I need a root canal.", "expect": {"service": "Root Canal Treatment"}},
    {"id": 8,  "say": "Just a cleaning and check-up for my daughter.", "expect": {"service_mentions": ["Teeth Cleaning", "General Check-up"], "for_someone_else": true}},
    {"id": 9,  "say": "Can I get Invisalign at the Indiranagar branch?", "expect": {"service": "Invisalign", "branch": "Indiranagar"}},
    {"id": 10, "say": "Whitefield is closer for me.", "expect": {"branch": "Whitefield"}},
    {"id": 11, "say": "Jayanagar, with a lady doctor if possible.", "expect": {"branch": "Jayanagar", "gender": "female"}},
    {"id": 12, "say": "Next Monday around five.", "expect": {"date_kind": "exact", "time": "17:00"}},
    {"id": 13, "say": "Tomorrow at ten thirty in the morning.", "expect": {"date_kind": "exact", "time": "10:30"}},
    {"id": 14, "say": "The twenty sixth, in the evening.", "expect": {"date_kind": "exact", "time_window": ["16:00", "21:00"]}},
    {"id": 15, "say": "Sometime next week, after five.", "expect": {"date_kind": "range", "time_window": ["17:00", "21:00"]}},
    {"id": 16, "say": "Half past four on Friday.", "expect": {"date_kind": "exact", "time": "16:30"}},
    {"id": 17, "say": "Whatever is earliest.", "expect": {"date_kind": "earliest"}},
    {"id": 18, "say": "Seven.", "expect": {"time_ambiguous": ["07:00", "19:00"]}, "expecting": "time"},
    {"id": 19, "say": "Seven in the evening.", "expect": {"time": "19:00"}},
    {"id": 20, "say": "Actually, make it Tuesday instead.", "expect": {"date_kind": "exact", "correction": true}},
    {"id": 21, "say": "The second one works.", "expect": {"choice": 2}},
    {"id": 22, "say": "What time do you close on Saturdays?", "expect": {"question": true}},
    {"id": 23, "say": "Where is your Jayanagar clinic?", "expect": {"question": true, "branch": "Jayanagar"}},
    {"id": 24, "say": "Sorry, can you repeat that?", "expect": {"repeat": true}},
    {"id": 25, "say": "Hold on a second.", "expect": {"wait": true}},
    {"id": 26, "say": "I want to cancel my appointment on the fifth.", "expect": {"intent": "cancel", "date_kind": "exact"}},
    {"id": 27, "say": "Can I move my cleaning to Thursday afternoon?", "expect": {"intent": "reschedule", "date_kind": "exact", "time_window": ["12:00", "16:00"]}},
    {"id": 28, "say": "I have really bad swelling and pain since last night.", "expect": {"emergency": "urgent"}},
    {"id": 29, "say": "Can I talk to a real person?", "expect": {"human": true}},
    {"id": 30, "say": "No, that's all, thank you. Bye.", "expect": {"end": true}}
  ]
}
